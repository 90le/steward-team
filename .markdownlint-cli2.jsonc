{
  // 中文文档为主，长行/表格常见；关掉与本仓库风格冲突、噪音大的规则，
  // 保留能捕获真实问题（断裂标题层级、Tab 缩进、行尾空格、无终止换行等）的规则。
  "config": {
    "default": true,
    "MD013": false, // 行长度：中文技术文档天然长句，不做限制
    "MD033": false, // 内联 HTML：注释/表格排版可能用到
    "MD041": false, // 首行必须是顶级标题：部分投影文件以引用块开头
    "MD024": false, // 重复标题：多个角色文档共用「## 职责」等小节标题
    "MD060": false  // 表格列样式：既有表格排版不做强制对齐，避免与本 PR 无关的大改动
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".git/**"]
}
